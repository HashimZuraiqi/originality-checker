# Copy to .env and adjust. Every setting is optional unless marked REQUIRED.

# --- Core -------------------------------------------------------------------
# development (default) | production. Production refuses to start without
# ENCRYPTION_KEY and COOKIE_SECURE=true.
ENVIRONMENT=development
# Fernet key used to encrypt documents, reports and files at rest.
# REQUIRED in production. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Set to true when served over HTTPS (marks the session cookie Secure, enables HSTS).
COOKIE_SECURE=false
# Used by docker-compose for the bundled PostgreSQL.
POSTGRES_PASSWORD=change-me
# Local runs default to SQLite in backend/data/app.db.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/originality

# --- Jobs -------------------------------------------------------------------
# true: worker threads inside the API process (simplest). docker-compose runs a
# separate worker container instead.
EMBEDDED_WORKER=true
WORKER_THREADS=2

# --- Limits -----------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_DOCUMENT_WORDS=60000
MAX_PDF_PAGES=300
MAX_QUERIES_PER_DOCUMENT=24
MAX_SOURCES_PER_DOCUMENT=40
DEFAULT_RETENTION_DAYS=90

# --- Source discovery ---------------------------------------------------------
# Contact address sent to OpenAlex and Crossref (their "polite pool" etiquette).
CONTACT_EMAIL=
ENABLE_OPENALEX=true
ENABLE_CROSSREF=true
ENABLE_SEMANTIC_SCHOLAR=true
SEMANTIC_SCHOLAR_API_KEY=
ENABLE_ARXIV=true
ENABLE_WIKIPEDIA=true
WIKIPEDIA_LANGUAGE=en
# Open-web search needs a licensed API key (one is enough). Without one the
# open web is not searched and every report says so.
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
FETCH_FULL_TEXT=true

# --- AI -----------------------------------------------------------------------
# Enables the Claude-powered writing assistant. Without it the on-server
# rule-based editor is used. Text is sent to Anthropic only when a user
# requests a rewrite and has the assistant enabled in Settings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# auto | sbert | wordvec | lexical
EMBEDDING_PROVIDER=auto
# Optional LanguageTool server for grammar/spelling, e.g. http://languagetool:8010
LANGUAGETOOL_URL=
